<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Qevra.App.ViewModels.Pages"
             xmlns:app="using:Qevra.App.ViewModels"
             x:Class="Qevra.App.Views.Pages.HomePage"
             x:DataType="vm:HomePageViewModel">
  <UserControl.Styles>
    <Style Selector="Border#DropZone">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.25" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="{StaticResource SoftEase}" />
          <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.3" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#DropZone.over">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NeonCyanBrush}" />
      <Setter Property="BoxShadow" Value="{DynamicResource GlassGlowCyanShadow}" />
      <Setter Property="RenderTransform" Value="scale(1.015)" />
    </Style>
    <Style Selector="PathIcon.chevron">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="PathIcon.chevron.open">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="22">

    <!-- Cyber Telemetry Studio Header -->
    <DockPanel>
      <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Classes="hud-pill" Margin="3,0">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="⚡" FontSize="10" />
            <TextBlock Text="CORE ENGINE: ACTIVE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" LetterSpacing="0.5" />
          </StackPanel>
        </Border>
        <Border Classes="hud-pill" Margin="3,0">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="🌸" FontSize="10" />
            <TextBlock Text="FLOWER RING: ARMED (Alt+Move)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource NeonVioletBrush}" LetterSpacing="0.5" />
          </StackPanel>
        </Border>
      </WrapPanel>
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" FontSize="22" FontWeight="Bold" LetterSpacing="0.8" Text="{DynamicResource home.title}" />
        <TextBlock Classes="caption" Text="// Universal Transmutation Studio &amp; Blossom Hub" Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </DockPanel>

    <!-- macOS without Accessibility permission: the drag gesture can't work yet. Gone once it is given. -->
    <Border IsVisible="{Binding NeedsAccessibility}" Background="{DynamicResource AccentFaintBrush}"
            BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="{DynamicResource SoftRadius}" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Classes="accent"
                Content="{DynamicResource triggers.open_accessibility}" Command="{Binding OpenAccessibilityCommand}" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource home.accessibility_needed}" />
      </DockPanel>
    </Border>

    <!-- Windows: Qevra runs as administrator while Explorer doesn't. Explorer can't drop files here, use the menu or
         have its selection read until Qevra runs with normal rights again. -->
    <Border IsVisible="{Binding IsElevated}" Background="{DynamicResource AccentFaintBrush}"
            BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="{DynamicResource SoftRadius}" Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Classes="accent"
                Content="{DynamicResource home.elevated_restart}" Command="{Binding RestartWithoutAdministratorRightsCommand}" />
        <StackPanel Spacing="6" VerticalAlignment="Center">
          <TextBlock TextWrapping="Wrap" Text="{DynamicResource home.elevated}" />
          <TextBlock Classes="caption danger" TextWrapping="Wrap" IsVisible="{Binding ElevationRestartFailed}"
                     Text="{DynamicResource home.elevated_restart_failed}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- The Glass Transmutation Chamber (DropZone) -->
    <Border x:Name="DropZone" DragDrop.AllowDrop="True" MinHeight="260"
            Cursor="Hand" ToolTip.Tip="{DynamicResource home.drop_select}"
            Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource GlassCardBorderBrush}"
            BorderThickness="1.5" CornerRadius="{DynamicResource SoftRadiusLarge}" Padding="32,24"
            BoxShadow="{DynamicResource GlassCardShadow}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        
        <!-- Glowing Holographic Logo Orb with floral pulse border -->
        <Border Width="92" Height="92" CornerRadius="26" Background="{DynamicResource GlassSurfaceAltBrush}"
                BorderBrush="{DynamicResource GlassCardBorderCyanBrush}" BorderThickness="1.8"
                BoxShadow="{DynamicResource GlassGlowCyanShadow}" HorizontalAlignment="Center">
          <Grid>
            <Image Source="avares://Qevra/Assets/Icons/qevra.png" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <StackPanel Spacing="4" HorizontalAlignment="Center">
          <TextBlock Classes="h1" FontSize="21" FontWeight="Bold" LetterSpacing="0.8" HorizontalAlignment="Center" Text="{DynamicResource home.drop_title}" />
          <TextBlock Classes="muted" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="540"
                     Text="{Binding DropHint}" />
        </StackPanel>
        
        <!-- Dedicated Instant Action Controls Deck -->
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
          <Button x:Name="SelectFilesButton" Classes="cyber-action" Margin="4"
                  AutomationProperties.Name="Select Files" ToolTip.Tip="Open system file picker">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.File}" Foreground="{DynamicResource NeonCyanBrush}" />
              <TextBlock Text="Select Files..." FontSize="12.5" FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button x:Name="PasteClipboardButton" Classes="cyber-action" Margin="4"
                  AutomationProperties.Name="From Clipboard" ToolTip.Tip="Convert copied files or image from clipboard">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Clipboard}" Foreground="{DynamicResource NeonAmberBrush}" />
              <TextBlock Text="From Clipboard" FontSize="12.5" FontWeight="SemiBold" />
            </StackPanel>
          </Button>

          <Button x:Name="TestFlowerRingButton" Classes="cyber-action" Margin="4"
                  AutomationProperties.Name="Test Flower Ring" ToolTip.Tip="Preview &amp; test the blooming flower petal radial menu">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="🌸" FontSize="13" />
              <TextBlock Text="Test Flower Ring" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource NeonVioletBrush}" />
            </StackPanel>
          </Button>
        </WrapPanel>

        <!-- Interactive Format Synthesizer Matrix -->
        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
          <Border Classes="synth-tile" Margin="3">
            <TextBlock Text="🖼️ Images: PNG, JPG, WEBP, SVG, GIF, AVIF" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Border Classes="synth-tile" Margin="3">
            <TextBlock Text="📄 Documents: PDF, DOCX, TXT, MD, EPUB" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Border Classes="synth-tile" Margin="3">
            <TextBlock Text="🎬 Media: MP4, MKV, MP3, WAV, FLAC" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Border Classes="synth-tile" Margin="3">
            <TextBlock Text="📐 3D &amp; CAD: OBJ, STL, GLTF, FBX" FontSize="11" FontWeight="SemiBold" />
          </Border>
          <Border Classes="synth-tile" Margin="3">
            <TextBlock Text="📦 Archives: ZIP, 7Z, TAR, GZ, BZ2" FontSize="11" FontWeight="SemiBold" />
          </Border>
        </WrapPanel>

      </StackPanel>
    </Border>

    <!-- Recent Conversions & Activity Terminal -->
    <StackPanel Spacing="12">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="ghost" Content="{DynamicResource home.clear_history}" Command="{Binding ClearHistoryCommand}" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="h2" VerticalAlignment="Center" Text="{DynamicResource home.recent}" />
          <Border Classes="hud-pill" Padding="6,1" VerticalAlignment="Center">
            <TextBlock Text="// LOG" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource NeonCyanBrush}" />
          </Border>
        </StackPanel>
      </DockPanel>

      <TextBox Classes="search clearButton" Text="{Binding Search}" PlaceholderText="{DynamicResource common.search}"
               IsVisible="{Binding !IsEmpty}">
        <TextBox.InnerLeftContent>
          <PathIcon Width="14" Height="14" Margin="10,0,0,0" Data="{StaticResource Icon.Search}" Foreground="{DynamicResource TextSecondaryBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>

      <!-- Empty state card -->
      <Border Classes="glass-card" Padding="24" IsVisible="{Binding IsEmpty}">
        <StackPanel HorizontalAlignment="Center" Spacing="8">
          <TextBlock Classes="h2" HorizontalAlignment="Center" Text="[ SYSTEM READY // AWAITING INPUT STREAM ]" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource NeonCyanBrush}" LetterSpacing="0.8" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" Text="{DynamicResource home.recent_empty}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="muted" Text="{DynamicResource home.no_matches}" IsVisible="{Binding NoMatches}" />

      <ItemsControl ItemsSource="{Binding History}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:HistoryItemViewModel">
            <Border Classes="glass-card history-card" Padding="14,10">
              <StackPanel Spacing="8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                              IsVisible="{Binding HasOutputs}">
                    <Button Command="{Binding OpenFileCommand}" IsVisible="{Binding CanOpen}" Padding="10,5">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.File}" />
                        <TextBlock Text="{DynamicResource home.open_file}" />
                      </StackPanel>
                    </Button>
                    <!-- Only where the system has an "Open with" dialog (Windows). -->
                    <Button Command="{Binding OpenWithCommand}" IsVisible="{Binding CanOpenWith}" Padding="8,5"
                            ToolTip.Tip="{DynamicResource home.open_with}" AutomationProperties.Name="{DynamicResource home.open_with}">
                      <PathIcon Width="13" Height="13" Data="{StaticResource Icon.OpenWith}" />
                    </Button>
                    <Button Command="{Binding OpenFolderCommand}" Padding="10,5">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Folder}" />
                        <TextBlock Text="{DynamicResource home.open_folder}" />
                      </StackPanel>
                    </Button>
                    <!-- Only while every result is as the job left it: they go to the Recycle Bin / Trash. -->
                    <Button Command="{Binding UndoCommand}" IsVisible="{Binding CanUndo}" Padding="10,5" ToolTip.Tip="{DynamicResource home.undo_hint}">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Undo}" />
                        <TextBlock Text="{DynamicResource home.undo}" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <!-- The result: its picture, else its format; the corner says whether the job went well. -->
                  <Panel DockPanel.Dock="Left" Width="42" Height="42" Margin="0,0,12,0">
                    <Border CornerRadius="{DynamicResource SoftRadiusSmall}" ClipToBounds="True" Background="{DynamicResource AccentSoftBrush}">
                      <Panel>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                        <TextBlock Text="{Binding FormatBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="!HasThumbnail" />
                              <Binding Path="HasFormatBadge" />
                            </MultiBinding>
                          </TextBlock.IsVisible>
                        </TextBlock>
                        <PathIcon Width="15" Height="15" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource AccentStrongBrush}">
                          <PathIcon.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                              <Binding Path="!HasThumbnail" />
                              <Binding Path="!HasFormatBadge" />
                            </MultiBinding>
                          </PathIcon.IsVisible>
                        </PathIcon>
                      </Panel>
                    </Border>
                    <Border Width="18" Height="18" CornerRadius="999" Margin="0,0,-4,-4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                      <Panel>
                        <PathIcon Width="10" Height="10" Data="{StaticResource Icon.Check}" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding !HasErrors}" />
                        <PathIcon Width="10" Height="10" Data="{StaticResource Icon.Alert}" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding HasErrors}" />
                      </Panel>
                    </Border>
                  </Panel>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="caption" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                      <TextBlock Classes="caption" Text="·" />
                      <TextBlock Classes="caption" Text="{Binding Time}" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>

                <TextBlock Classes="caption" Margin="54,0,0,0" TextWrapping="Wrap" Text="{Binding UndoneText}" IsVisible="{Binding IsUndone}" />
                <TextBlock Classes="caption danger" Margin="54,0,0,0" TextWrapping="Wrap" Text="{Binding UndoError}" IsVisible="{Binding HasUndoError}" />

                <!-- Failed files: the list on demand, and converting them again -->
                <DockPanel IsVisible="{Binding HasFailures}" Margin="54,0,0,0">
                  <Button DockPanel.Dock="Right" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Padding="10,5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Refresh}" />
                      <TextBlock Text="{DynamicResource common.retry}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="ghost" Command="{Binding ToggleFailuresCommand}" Padding="6,4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Classes="chevron reading" Classes.open="{Binding ShowFailures}" Width="12" Height="12"
                                Data="{StaticResource Icon.ChevronRight}" />
                      <TextBlock Classes="caption danger" Text="{Binding FailureSummary}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Failures}" IsVisible="{Binding ShowFailures}" Margin="60,0,0,2">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="app:FailureItem">
                      <StackPanel>
                        <SelectableTextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                        <SelectableTextBlock Classes="caption danger" Text="{Binding Reason}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </StackPanel>
</UserControl>
