<!-- Main window: clean left navigation sidebar + current page. Closing hides to the tray. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Qevra.App.ViewModels"
        x:Class="Qevra.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Qevra"
        Icon="avares://Qevra/Assets/Icons/qevra.ico"
        Width="1080" Height="760" MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="Auto,*">
    <!-- Navigation: full width with titles, or collapsed to an icon rail (tooltips instead of text). -->
    <Border Classes="navpane" Classes.collapsed="{Binding IsNavCollapsed}" Width="{Binding NavWidth}" ClipToBounds="True"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="{Binding NavPadding}">
        
        <!-- Top: Logo & Title -->
        <StackPanel DockPanel.Dock="Top" Classes="navheader" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                  BoxShadow="{DynamicResource CardShadow}" VerticalAlignment="Center">
            <Image Source="avares://Qevra/Assets/Icons/qevra.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel VerticalAlignment="Center" IsVisible="{Binding !IsNavCollapsed}">
            <TextBlock Text="Qevra" FontSize="16" FontWeight="SemiBold" LetterSpacing="-0.2" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Classes="caption" Text="{DynamicResource app.tagline}" />
          </StackPanel>
        </StackPanel>

        <!-- Bottom: Sidebar toggle, Version, Updates, GitHub & Sponsor -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="4,12,4,0">
          
          <!-- Collapsed view icons -->
          <StackPanel Spacing="8" IsVisible="{Binding IsNavCollapsed}">
            <Button Classes.accent="{Binding !Updates.IsOptional}" Padding="8,6" HorizontalAlignment="Stretch"
                    Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                    ToolTip.Tip="{Binding UpdateTip}" ToolTip.Placement="Right"
                    AutomationProperties.Name="{Binding UpdateText}">
              <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Download}" />
            </Button>
            <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnOpenGitHub"
                    ToolTip.Tip="{Binding RepositoryUrl}" ToolTip.Placement="Right"
                    AutomationProperties.Name="GitHub">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.GitHub}" />
            </Button>
            <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnSponsor"
                    ToolTip.Tip="{DynamicResource about.sponsor}" ToolTip.Placement="Right"
                    AutomationProperties.Name="{DynamicResource about.sponsor}">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
            </Button>
          </StackPanel>

          <!-- Expanded view footer -->
          <StackPanel Spacing="8" IsVisible="{Binding !IsNavCollapsed}">
            <!-- Update Button -->
            <Button x:Name="UpdateButton" Classes.accent="{Binding !Updates.IsOptional}" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding DownloadUpdateCommand}" IsVisible="{Binding Updates.IsUpdateAvailable}"
                    ToolTip.Tip="{Binding UpdateTip}" AutomationProperties.Name="{Binding UpdateText}">
              <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource DangerBrush}" IsVisible="{Binding Updates.IsRequired}">
                  <TextBlock Text="{DynamicResource update.pill.Required}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                </Border>
                <Border DockPanel.Dock="Right" CornerRadius="999" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceAltBrush}" IsVisible="{Binding Updates.IsOptional}">
                  <TextBlock Classes="caption" Text="{DynamicResource update.pill.Optional}" FontSize="11" />
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Width="14" Height="14" Data="{StaticResource Icon.Download}" />
                  <TextBlock Text="{Binding UpdateText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </Button>

            <!-- GitHub & Sponsor -->
            <Grid ColumnDefinitions="*,6,*">
              <Button Classes="navlink" HorizontalAlignment="Stretch" Click="OnOpenGitHub" ToolTip.Tip="{Binding RepositoryUrl}"
                      AutomationProperties.Name="GitHub">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Icon.GitHub}" />
                  <TextBlock Text="GitHub" />
                </StackPanel>
              </Button>
              <Button Grid.Column="2" Classes="navlink" HorizontalAlignment="Stretch" Click="OnSponsor"
                      ToolTip.Tip="{DynamicResource about.sponsor}" AutomationProperties.Name="{DynamicResource about.sponsor}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
                  <TextBlock Text="{DynamicResource about.sponsor}" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- Version -->
            <TextBlock x:Name="VersionLabel" Classes="caption" Margin="6,2,0,0" Text="{Binding VersionText}" />
          </StackPanel>

          <!-- Sidebar Collapse/Expand Toggle -->
          <Button Classes="icon navtoggle" Margin="0,4,0,0" Command="{Binding ToggleNavCommand}"
                  ToolTip.Tip="{Binding NavToggleTip}" ToolTip.Placement="Right" AutomationProperties.Name="{Binding NavToggleTip}">
            <PathIcon Width="16" Height="16" Data="{StaticResource Icon.Sidebar}" />
          </Button>
        </StackPanel>

        <!-- Navigation Items List -->
        <ListBox Classes="nav" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <Border Background="Transparent" Padding="12,9" CornerRadius="{DynamicResource SoftRadiusSmall}"
                      ToolTip.Tip="{Binding Tip}" ToolTip.Placement="Right"
                      AutomationProperties.Name="{Binding Title}">
                <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                  <PathIcon Classes="navicon" Width="16" Height="16" Data="{Binding Icon}" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" IsVisible="{Binding ShowTitle}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

      </DockPanel>
    </Border>

    <!-- Main Content Area -->
    <ScrollViewer Grid.Column="1" x:Name="PageScroller" VerticalScrollBarVisibility="{Binding PageScroll}">
      <ContentControl Classes="page" Content="{Binding CurrentPage}" Margin="32,26,32,32" MaxWidth="960" HorizontalAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
